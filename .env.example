APP_NAME="Print Works LK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Production: https://api.printworks.lk  |  Local: http://localhost:8000
APP_URL=https://api.printworks.lk

# Storefront (Next.js) — used for CORS, PayHere return URLs, quote links
FRONTEND_URL=https://printworks.lk

# Optional extra browser origins (comma-separated). FRONTEND_URL is always included.
CORS_ALLOWED_ORIGINS=https://www.printworks.lk

# Uploads: php artisan storage:link  →  public/storage → storage/app/public
# All uploaded media URLs use APP_URL + /storage/… (e.g. https://api.printworks.lk/storage/products/…)
#
# IMPORTANT (Coolify/Docker): storage:link does NOT delete files.
# Photos disappear after redeploy when uploads are NOT on a persistent volume.
# Mount volume: /var/www/html/storage/app/public
# Check: php artisan storage:health

LOG_CHANNEL=stack
LOG_LEVEL=info

# MySQL (Coolify: use service hostname, e.g. mysql or container name)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=printworks_db
DB_USERNAME=root
DB_PASSWORD=

# Redis (cache, sessions, queues) — recommended in production
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Cookies / Sanctum (frontend on printworks.lk, API on api.printworks.lk)
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.printworks.lk
SANCTUM_STATEFUL_DOMAINS=printworks.lk,www.printworks.lk,api.printworks.lk

# S3 / Cloudflare R2 (optional — use public disk if not set)
# Storage: 'public' = local disk (dev), 'b2' = Backblaze B2 (production)
FILESYSTEM_DISK=public

# Backblaze B2 — set FILESYSTEM_DISK=b2 in production
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=us-east-005
B2_BUCKET=printworks-storage
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_PUBLIC_URL=https://f005.backblazeb2.com/file/printworks-storage

# Legacy S3 / R2 (not used when B2 is configured)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mail.printworks.lk
MAIL_PORT=465
MAIL_USERNAME=no-reply@printworks.lk
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@printworks.lk
MAIL_FROM_NAME="${APP_NAME}"

CHAT_NOTIFICATION_EMAIL=admin@printworks.lk
ADMIN_EMAIL=admin@printworks.lk

# WhatsApp API (HostGrap)
WHATSAPP_API_EMAIL=
WHATSAPP_API_KEY=
# Comma-separated numbers for internal chat alerts, e.g. 94771234567,94779876543
WHATSAPP_ALERT_NUMBERS=

# AI providers (comma-separated). First = primary, next = fallback on error/quota.
AI_LLM_PROVIDERS=gemini,claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic Claude (fallback)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

AI_STORE_NAME=Print Works.LK
# AI_SERVICE_TIMEOUT=60

# ─── Local development overrides ───
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=
# SESSION_SECURE_COOKIE=false
# SESSION_DOMAIN=
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000
# CACHE_STORE=file
# SESSION_DRIVER=file
# QUEUE_CONNECTION=sync
